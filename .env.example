# Amadeus API credentials (recommended for the hackathon demo)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# demo | amadeus | playwright
FARE_PROVIDER=demo

# How often the backend automatically refreshes fares.
SCRAPE_INTERVAL_HOURS=4

# SQLite DB used by the backend
DATABASE_PATH=data/fareindex.db

# Routes to track
TRACKED_ROUTES=HYD-DEL,HYD-GOI

# Booking windows used for fresh scheduled collection
BOOKING_WINDOWS_DAYS=3,7,14,21,30,60
